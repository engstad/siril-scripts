requires 1.2.0

###########################################################################################
#
# Lum
#
###########################################################################################

cd Light/Lum
convert light -out=../../process/lum
cd ../../process/lum

calibrate light -bias="=200+4*$OFFSET" -flat=../../../Flat/lum-flat
register pp_light -drizzle -scale=1 -pixfrac=1.0 -kernel=square -flat=../../../Flat/lum-flat
stack r_pp_light rej 3 3 -norm=addscale -output_norm -32b -out=lum
mirrorx_single lum
load lum
save ../../lum_result_$LIVETIME:%d$s
cd ../..

