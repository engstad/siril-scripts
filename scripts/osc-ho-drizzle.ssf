requires 1.2.0

###########################################################################################
#
# HA + OIII
#
###########################################################################################

# Convert Light Frames to .fit files
cd Light/HA-OIII
convert light -out=../../process/ha-oiii
cd ../../process/ha-oiii

# Calibrate Light Frames
# calibrate light -dark=/Users/pengstad/Pictures/Masters/dark_e120_g100_o50_t3_stacked -flat=../../flat-ha-oiii -cc=dark -cfa -equalize_cfa
calibrate light -dark=/Users/pengstad/Pictures/Masters/dark_e180_g100_o50_t-10_stacked -flat=../../flat-ha-oiii -cc=dark -cfa -equalize_cfa

seqextract_HaOIII pp_light -resample=ha # ha sometimes doesn't work

# Align Ha lights
register Ha_pp_light -drizzle -scale=1 -pixfrac=1.0 -kernel=square -flat=../../flat-ha-oiii

# Stack calibrated Ha lights to Ha_stack (temporary)
stack r_Ha_pp_light rej 1.5 1.5 -norm=addscale -output_norm -32b -out=results_00001

# and flip if required
mirrorx_single results_00001

# Align OIII lights
register OIII_pp_light -drizzle -scale=1 -pixfrac=1.0 -kernel=square -flat=../../flat-ha-oiii

# Stack calibrated OIII lights to OIII_stack (temporary)
stack r_OIII_pp_light rej 1.5 1.5 -norm=addscale -output_norm -32b -out=results_00002

# and flip if required
mirrorx_single results_00002

rgbcomp results_00001 results_00002 results_00002 -out=result -nosum

load result
save ../../ho_drizzled_result_$LIVETIME:%d$s

# close
