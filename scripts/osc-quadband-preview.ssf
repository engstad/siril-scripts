cd Light/Quadband
convert light -out=../../process/quadband
cd ../../process/quadband

# calibrate light -dark=../../dark_stacked -cc=dark -cfa -debayer -equalize_cfa
# calibrate light -dark=/Volumes/T9/Pictures/Masters/dark_e120_g100_o50_t3_stacked -cfa -debayer -equalize_cfa2
